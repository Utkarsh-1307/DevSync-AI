# ============================================================
# DevSync AI — Environment Variables
# Copy to .env and fill in real values before running.
# ============================================================

# App
APP_NAME="DevSync AI"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# CORS
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://devsync:devsync_dev@localhost:5432/devsync

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM=noreply@devsync.ai

# AI
ANTHROPIC_API_KEY=sk-ant-...
DEFAULT_AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096

# OAuth Providers (optional — leave blank to disable OAuth buttons)
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Storage (optional)
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Observability
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=console
